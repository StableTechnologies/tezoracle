{
  "name": "tezoracle",
  "version": "0.0.0",
  "private": true,
  "description": "Configurable N-of-M Tezos price oracle. Testnet and non-authoritative shadow only.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/validator/smoke.test.ts tests/packing/vectors.test.ts tests/config/register.test.ts",
    "test:packing": "node --import tsx --test tests/packing/vectors.test.ts",
    "packing:freeze-vectors": "tsx scripts/freeze-packing-vectors.ts",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
