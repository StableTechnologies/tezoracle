# TezOracle runtime placeholders.
# Copy to `.env` for local/testnet use. Never commit `.env` or production values.
# This repository is not authorized for production keys, endpoints, or signer material.

# Tezos RPC used for simulation and (later) testnet origination.
TEZOS_RPC_URL=
TEZOS_NETWORK=ghostnet

# Originated oracle contract and chain. Leave empty until a testnet deploy exists.
ORACLE_ADDRESS=
TEZOS_CHAIN_ID=

# Testnet-only signer secret (e.g. edsk...). Must never be a production key.
TEZORACLE_SIGNER_SECRET_KEY=

# Optional local services. Coordinator and relayer hold no signing keys.
COORDINATOR_URL=
RELAYER_RPC_URL=
